{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cp2077-panorama-taker/session.schema.json",
  "title": "Cyberpunk 2077 panorama capture session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "capture_mode",
    "projection",
    "viewport",
    "fov",
    "base_pose",
    "planner",
    "frames",
    "completed"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "game_version": { "type": "string", "minLength": 1 },
    "red4ext_version": { "type": "string", "minLength": 1 },
    "mod_version": { "type": "string", "minLength": 1 },
    "created_utc": { "type": "string", "format": "date-time" },
    "capture_mode": { "enum": ["horizontal", "full_sphere"] },
    "projection": { "type": "string", "const": "rectilinear" },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "image_encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_type", "color_primaries", "transfer_function", "reference_white_nits"],
      "properties": {
        "sample_type": { "enum": ["uint8", "uint16", "float16", "float32"] },
        "color_primaries": { "enum": ["srgb", "rec2020"] },
        "transfer_function": { "enum": ["srgb", "pq", "linear"] },
        "reference_white_nits": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "fov": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal_deg", "vertical_deg", "source"],
      "properties": {
        "horizontal_deg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "vertical_deg": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "source": { "enum": ["render_projection_matrix", "configured_value"] }
      }
    },
    "base_pose": { "$ref": "#/$defs/pose" },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlap_fraction", "yaw_step_deg", "pitch_step_deg"],
      "properties": {
        "overlap_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "yaw_step_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "pitch_step_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 }
      }
    },
    "render_timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_real_settle_frames": { "type": "integer", "minimum": 0 },
        "real_fps_at_start": { "$ref": "#/$defs/finiteNumber" },
        "presented_fps_at_start": { "$ref": "#/$defs/finiteNumber" },
        "frame_generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "active_backend": { "type": "string" },
            "raw_settings": { "type": "object" }
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/$defs/frame" }
    },
    "completed": { "type": "boolean" }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false
    },
    "quaternionXYZW": {
      "type": "array",
      "description": "Quaternion components in X, Y, Z, W order.",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false
    },
    "matrix16": {
      "type": "array",
      "description": "A 4x4 row-major matrix. Engine handedness and clip-space convention are documented by the consumer implementation.",
      "prefixItems": [
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
        { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" }
      ],
      "items": false
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation_xyzw"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "orientation_xyzw": { "$ref": "#/$defs/quaternionXYZW" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "filename",
        "yaw_deg",
        "pitch_deg",
        "roll_deg",
        "status"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "filename": { "type": "string", "minLength": 1 },
        "yaw_deg": { "$ref": "#/$defs/finiteNumber" },
        "pitch_deg": { "$ref": "#/$defs/finiteNumber" },
        "roll_deg": { "$ref": "#/$defs/finiteNumber" },
        "position": { "$ref": "#/$defs/vector3" },
        "orientation_xyzw": { "$ref": "#/$defs/quaternionXYZW" },
        "camera_basis_row_major": {
          "type": "array",
          "description": "Rows are camera right, up, and forward in canonical world coordinates.",
          "prefixItems": [
            { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
            { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
            { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
            { "$ref": "#/$defs/finiteNumber" }, { "$ref": "#/$defs/finiteNumber" },
            { "$ref": "#/$defs/finiteNumber" }
          ],
          "items": false
        },
        "observed_forward": { "$ref": "#/$defs/vector3" },
        "observed_right": { "$ref": "#/$defs/vector3" },
        "observed_up": { "$ref": "#/$defs/vector3" },
        "view_matrix_row_major": { "$ref": "#/$defs/matrix16" },
        "projection_matrix_row_major": { "$ref": "#/$defs/matrix16" },
        "settled_real_frames": { "type": "integer", "minimum": 0 },
        "real_fps_before_capture": { "$ref": "#/$defs/finiteNumber" },
        "status": { "enum": ["planned", "captured", "failed"] }
      }
    }
  }
}
